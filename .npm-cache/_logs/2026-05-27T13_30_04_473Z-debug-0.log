8 verbose argv "exec" "--" "tsx" "-e" "\nconst { getDatabase } = require('./src/lib/persistence/database');\nconst db = getDatabase();\nconst row = db.getSimulationConfig();\nconst config = JSON.parse(row.config_json);\n\n// Add TOP5000 to USA universes\nconst usa = config.regions.find(r => r.value === 'USA');\nif (!usa.universes.includes('TOP5000')) {\n  usa.universes.push('TOP5000');\n}\n\n// Add a brand new region\nconfig.regions.push({\n  value: 'JPN',\n  label: 'Japan',\n  universes: ['TOP1000', 'TOP500']\n});\n\nconfig.version += 1;\nconfig.updatedAt = new Date().toISOString();\ndb.saveSimulationConfig(JSON.stringify(config), config.version);\nconsole.log('Updated config version', config.version);\nconsole.log('USA universes:', usa.universes);\nconsole.log('All regions:', config.regions.map(r => r.value + ' (' + r.universes.join(',') + ')'));\n"
